{
  "name": "@photovoks/print-station",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@photovoks/shared-types": "workspace:*",
    "@supabase/supabase-js": "2.45.4",
    "better-sqlite3": "9.6.0",
    "electron-log": "5.2.0",
    "electron-store": "8.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "31.7.7",
    "electron-builder": "25.1.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.4.5",
    "vite": "5.4.19",
    "vite-plugin-electron": "0.28.8"
  },
  "build": {
    "appId": "com.photovoks.print-station",
    "productName": "Photovoks Print Station",
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
