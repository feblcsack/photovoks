# ============================================================
# Photovoks Print Station — Environment Variables
# Set these in the system environment or a .env file loaded
# by the Electron main process at startup.
# ============================================================

# Supabase project URL
SUPABASE_URL=

# Supabase service role key — scoped to print_jobs and
# print_station_heartbeat tables via RLS policies.
SUPABASE_SERVICE_ROLE_KEY=

# System printer name.
# macOS: run `lpstat -p` to list available printers.
# Windows: check Settings > Printers & scanners for the exact name.
PRINTER_NAME=
