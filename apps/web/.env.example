# Photovoks — copy to .env.local (or run `pnpm configure`, recommended).
# NEVER commit real keys. .env.local is git-ignored.

# ── Supabase (Dashboard → Project Settings → API) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions ────────────────────────────────────────────────────────────────
# Random string ≥ 32 chars. Signs admin + event-PIN cookies.
# Changing it logs everyone out. `pnpm configure` generates one.
ADMIN_SESSION_SECRET=

# ── AI photo styles via OpenRouter (server only) ────────────────────────────
# https://openrouter.ai/keys — empty = AI styles hidden for guests.
OPENROUTER_API_KEY=
# Any OpenRouter model that accepts an input image and returns an image.
OPENROUTER_MODEL=google/gemini-2.5-flash-image
# "images" (default: POST /api/v1/images) or "chat" (POST /chat/completions
# with modalities ["image","text"]) for models only served via chat.
# OPENROUTER_API_MODE=images
# Public URL of this app, sent as HTTP-Referer to OpenRouter (optional).
# APP_URL=https://booth.example.com

# Optional legacy provider: direct Google Gemini (AI_PROVIDER=gemini).
# AI_PROVIDER=openrouter
# GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-2.5-flash-image

# ── Print worker (only on the computer wired to the printer) ────────────────
# `pnpm print -- --list` shows names. "dry-run" saves files to ./print-output.
PRINTER_NAME=
# PRINT_EVENT_CODES=ABC123,XYZ789   # only print these events' jobs
# PRINT_MEDIA=4x6                    # CUPS media name (some DNP: w288h432)
# PRINT_LP_OPTIONS=                  # extra `lp -o` options, space separated
# PRINT_WORKER=off                   # don't start the worker inside `pnpm booth`
