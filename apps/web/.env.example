# Photovoks — copy to .env.local, or just run `pnpm configure` (recommended).
# NEVER commit real keys. .env.local is git-ignored.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (https://aistudio.google.com/apikey). Empty = AI doodle off.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash-image

# Printer on THIS computer (`pnpm print --list`). "dry-run" = save files to ./print-output.
# Empty = this server does not print.
PRINTER_NAME=

# Random string (≥32 chars) that signs admin sessions. `pnpm configure` generates it.
ADMIN_SESSION_SECRET=

# Optional:
# PRINT_MEDIA=4x6                 # CUPS media name (some DNP printers: w288h432)
# PRINT_LP_OPTIONS=               # extra `lp -o` options, space separated
# PRINT_WORKER=off                # don't start the printer inside `pnpm booth`
