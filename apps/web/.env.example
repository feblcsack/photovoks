# Photovoks — copy to .env.local (or run `pnpm configure`, recommended).
# NEVER commit real keys. .env.local is git-ignored.

# ── Supabase (Dashboard → Project Settings → API) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions ────────────────────────────────────────────────────────────────
# Random string ≥ 32 chars. Signs admin + event-PIN cookies.
# Changing it logs everyone out. `pnpm configure` generates one.
ADMIN_SESSION_SECRET=

# ── AI photo styles via OpenRouter (server only) ────────────────────────────
# https://openrouter.ai/keys — empty = AI styles hidden for guests.
OPENROUTER_API_KEY=
# Any OpenRouter model that accepts an input image and returns an image.
OPENROUTER_MODEL=google/gemini-2.5-flash-image
# "images" (default: POST /api/v1/images) or "chat" (POST /chat/completions
# with modalities ["image","text"]) for models only served via chat.
# OPENROUTER_API_MODE=images
# Public URL of this app, sent as HTTP-Referer to OpenRouter (optional).
# APP_URL=https://booth.example.com

# Optional legacy provider: direct Google Gemini (AI_PROVIDER=gemini).
# AI_PROVIDER=openrouter
# GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-2.5-flash-image

# ── Print worker (only on the computer wired to the printer) ────────────────
# `pnpm print -- --list` shows names. "dry-run" saves files to ./print-output.
PRINTER_NAME=
# PRINT_EVENT_CODES=ABC123,XYZ789   # only print these events' jobs
# PRINT_MEDIA=4x6                    # CUPS media name (some DNP: w288h432)
# PRINT_LP_OPTIONS=                  # extra `lp -o` options, space separated
# PRINT_WORKER=off                   # don't start the worker inside `pnpm booth`

# ── v5: QRIS payments via Aulaa (https://aulaa.co) — server only ────────────
# Dashboard → Projects (type API) → API Keys / Webhook. Callback URL:
#   https://<domain>/api/payments/aulaa/webhook
# Empty = QRIS hidden, guests pay at the cashier (operator approves).
# AULAA_API_KEY=pgw_id_xxxxxxxxxxxxxxxx
# AULAA_WEBHOOK_SECRET=

# ── v5: photo storage on Cloudflare R2 / any S3 (optional, recommended) ─────
# R2 has no egress fees. Choose it in Portal Pemilik › Developer › Penyimpanan.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=photovoks
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ── v5: backup Supabase project (different organisation = separate quota) ───
# SUPABASE_URL_2=https://<backup-project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY_2=
# DB_ACTIVE=secondary            # switch every server query to the backup

# ── v5: emergency overrides (work even when the database is unreachable) ────
# MAINTENANCE_MODE=1             # guest pages show the maintenance screen
# STORAGE_DRIVER=s3              # force new uploads to R2/S3
# AI_DISABLED=1                  # hide AI everywhere
# PAYMENTS_DISABLED=1            # everything free
# MEDIA_MEMORY_CACHE_MB=96       # RAM cache for /media (0 = off)
# MEDIA_SIGNING_SECRET=          # defaults to ADMIN_SESSION_SECRET

# ── v5.1: QRIS via DOKU Checkout (https://docs.doku.com) — server only ──────
# Back Office › Settings › API Keys. Notification URL:
#   https://<domain>/api/payments/doku/notify
# DOKU_CLIENT_ID=
# DOKU_SECRET_KEY=
# DOKU_ENV=sandbox               # production when live
# DOKU_ALL_METHODS=1             # show every activated method (VA, e-wallet…) instead of QRIS only
# PAYMENT_PROVIDER=doku          # force the QRIS gateway (doku | aulaa)
